{
  "manifest_version": 3,
  "name": "Szmelc-RCE",
  "version": "1.1.0",
  "homepage_url": "https://szmelc.com",
  "description": "Szmelc-INC Remote Control Extension (agent in your browser, fully self-hostable)",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Szmelc-RCE",
    "default_icon": {
      "16": "action/icon-16.png",
      "32": "action/icon-32.png",
      "48": "action/icon-48.png",
      "128": "action/icon-128.png"
    }
  },
  "options_page": "options.html",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "debugger",
    "tabGroups",
    "tabs",
    "alarms",
    "notifications",
    "webNavigation",
    "declarativeNetRequestWithHostAccess",
    "offscreen",
    "nativeMessaging",
    "unlimitedStorage",
    "downloads",
    "identity",
    "favicon"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "content_scripts": [
    {
      "js": [
        "assets/content-script.ts-loader-D2HlXAAI.js"
      ],
      "matches": [
        "https://szmelc.com/*",
        "https://*.szmelc.com/*"
      ],
      "run_at": "document_end"
    },
    {
      "js": [
        "assets/accessibility-tree.js-BICiAnsh.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "js": [
        "assets/cursor-motion.js-uBhCC_Vx.js",
        "assets/agent-visual-indicator.js-CpmhqLhr.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://szmelc.com/*",
      "https://*.szmelc.com/*"
    ]
  },
  "commands": {
    "toggle-side-panel": {
      "suggested_key": {
        "default": "Ctrl+E",
        "mac": "Command+E"
      },
      "description": "Toggle Szmelc-RCE side panel"
    }
  },
  "key": "",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https: http: wss: ws:; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:;"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "https://*.szmelc.com/*",
        "https://szmelc.com/*"
      ],
      "resources": [
        "assets/onboarding-prompts-CJtFEMjA.js",
        "assets/content-script.ts-C6lrM1Zv.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "assets/accessibility-tree.js-BICiAnsh.js",
        "assets/cursor-motion.js-uBhCC_Vx.js",
        "assets/agent-visual-indicator.js-CpmhqLhr.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
